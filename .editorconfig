# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
# Match Ruff's line-length setting; support varies between editors.
max_line_length = 100

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{js,mjs,cjs}]
indent_size = 2

[*.md]
# Preserve Markdown hard line breaks.
trim_trailing_whitespace = false

[*.{bat,cmd}]
# Match .gitattributes for Windows command scripts.
end_of_line = crlf

[*.forces]
# Recordings are read-only; never normalize their original bytes.
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
max_line_length = unset
insert_final_newline = false
trim_trailing_whitespace = false
