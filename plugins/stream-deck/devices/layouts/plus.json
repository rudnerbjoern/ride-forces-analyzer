{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
    "id": "analyzer-plus",
    "controller": "Encoder",
    "items": [
        { "key": "background", "type": "pixmap", "rect": [0, 0, 200, 100], "zOrder": 0 },
        { "key": "icon", "type": "pixmap", "rect": [4, 1, 24, 24], "zOrder": 2 },
        {
            "key": "title",
            "type": "text",
            "rect": [32, 1, 164, 22],
            "font": { "size": 13, "weight": 600 },
            "alignment": "left",
            "text-overflow": "ellipsis",
            "color": "#ffffff",
            "zOrder": 3
        },
        {
            "key": "value",
            "type": "text",
            "rect": [4, 24, 192, 23],
            "font": { "size": 16, "weight": 600 },
            "alignment": "left",
            "text-overflow": "ellipsis",
            "color": "#ffffff",
            "zOrder": 3
        },
        { "key": "band", "type": "pixmap", "rect": [0, 48.1818, 200, 26], "zOrder": 1 },
        { "key": "statusIcon", "type": "pixmap", "rect": [3, 48.1818, 26, 26], "zOrder": 2 },
        {
            "key": "status",
            "type": "text",
            "rect": [34, 48.1818, 162, 26],
            "font": { "size": 14, "weight": 600 },
            "alignment": "left",
            "text-overflow": "ellipsis",
            "color": "#a6c5e1",
            "zOrder": 3
        },
        {
            "key": "detail",
            "type": "text",
            "rect": [4, 75, 192, 12],
            "font": { "size": 11 },
            "alignment": "left",
            "text-overflow": "ellipsis",
            "color": "#c1d1e2",
            "zOrder": 3
        },
        {
            "key": "hint",
            "type": "text",
            "rect": [4, 88, 192, 12],
            "font": { "size": 11 },
            "alignment": "left",
            "text-overflow": "ellipsis",
            "color": "#b8dbff",
            "zOrder": 3
        }
    ]
}
