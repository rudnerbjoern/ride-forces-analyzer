{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "analyzer-plus",
  "controller": "Encoder",
  "items": [
    { "key": "icon", "type": "pixmap", "rect": [4, 2, 28, 28] },
    { "key": "title", "type": "text", "rect": [36, 4, 160, 22], "font": { "size": 14, "weight": 600 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#ffffff" },
    { "key": "value", "type": "text", "rect": [4, 30, 192, 24], "font": { "size": 16, "weight": 600 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#ffffff" },
    { "key": "status", "type": "text", "rect": [4, 56, 192, 19], "font": { "size": 12 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#b8dbff" },
    { "key": "detail", "type": "text", "rect": [4, 77, 192, 20], "font": { "size": 11 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#ffffff" }
  ]
}
