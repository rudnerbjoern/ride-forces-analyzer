{
    "name": "@ride-forces-analyzer/stream-deck",
    "version": "1.0.1",
    "private": true,
    "description": "Stream Deck controls and confirmed application feedback for Ride Forces Analyzer",
    "type": "module",
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "format:check": "prettier --check .",
        "build": "tsc --project tsconfig.json",
        "build:plugin": "node scripts/build-plugin.mjs",
        "pack:plugin": "npm run build:plugin && npm run pack:built-plugin --",
        "pack:built-plugin": "node scripts/pack-plugin.mjs",
        "validate:plugin": "streamdeck validate ../../.tmp/stream-deck/io.github.rudnerbjoern.ride-forces-analyzer.sdPlugin --no-update-check",
        "link:plugin": "node scripts/link-plugin.mjs",
        "restart:plugin": "streamdeck restart io.github.rudnerbjoern.ride-forces-analyzer",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "test": "npm run build:plugin && node --test tests/*.test.mjs && npm run test:reference",
        "test:reference": "uv run --locked pytest tests/test_reference.py",
        "version": "node scripts/version.mjs --sync",
        "check:version": "node scripts/version.mjs"
    },
    "prettier": "@elgato/prettier-config",
    "dependencies": {
        "@elgato/streamdeck": "3.0.4"
    },
    "devDependencies": {
        "@elgato/cli": "1.10.4",
        "@elgato/eslint-config": "0.3.2",
        "@elgato/prettier-config": "0.3.3",
        "@eslint/js": "9.39.5",
        "@types/node": "26.6.6",
        "@zip.js/zip.js": "2.24.0",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "eslint-plugin-jsdoc": "65.4.2",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.1"
    }
}
