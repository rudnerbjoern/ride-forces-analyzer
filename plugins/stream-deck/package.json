{
  "name": "@ride-forces-analyzer/stream-deck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck controls and confirmed application feedback for Ride Forces Analyzer",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "validate:plugin": "streamdeck validate io.github.rudnerbjoern.ride-forces-analyzer.sdPlugin --no-update-check",
    "link:plugin": "streamdeck link io.github.rudnerbjoern.ride-forces-analyzer.sdPlugin",
    "restart:plugin": "streamdeck restart io.github.rudnerbjoern.ride-forces-analyzer",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build:plugin && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
