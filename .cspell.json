{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "import": [
    "@cspell/dict-de-de/cspell-ext.json",
    "@cspell/dict-fr-fr/cspell-ext.json"
  ],
  "overrides": [
    {
      "filename": ".agents/skills/**/*.md",
      "dictionaries": [
        "html"
      ]
    },
    {
      "filename": "src/ride_forces_analyzer/i18n/de.py",
      "language": "en,de"
    },
    {
      "filename": "src/ride_forces_analyzer/i18n/fr.py",
      "language": "en,fr"
    }
  ],
  "files": [
    "**/*.{md,py,mjs,json,jsonc,toml,yml,yaml}",
    ".github/workflows/*.{yml,yaml}",
    ".github/scripts/*.mjs",
    ".agents/skills/**/*.{md,py,ps1}",
    ".github/**/*.md",
    ".vscode/*.json",
    ".codex/*.toml",
    ".cspell.json",
    ".markdownlint-cli2.jsonc"
  ],
  "ignorePaths": [
    "**/.git/**",
    "**/.tmp/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/build/**",
    "**/dist/**",
    "**/*.egg-info/**",
    "**/*.forces",
    "**/package-lock.json",
    "**/uv.lock"
  ],
  "words": [
    "AHRS",
    "Aileron",
    "Alembic",
    "allclose",
    "Anson",
    "ast",
    "Bahnschrift",
    "basetemp",
