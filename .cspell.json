{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "files": [
    "**/*.{md,py,mjs,json,jsonc,toml,yml,yaml}",
    ".github/workflows/*.{yml,yaml}",
    ".github/scripts/*.mjs",
    ".agents/skills/**/*.{md,py,ps1}",
    ".github/**/*.md",
    ".vscode/*.json",
    ".codex/*.toml",
    ".cspell.json",
    ".markdownlint-cli2.jsonc"
  ],
  "ignorePaths": [
    "**/.git/**",
    "**/.tmp/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/build/**",
    "**/dist/**",
    "**/*.egg-info/**",
    "**/*.forces",
    "**/package-lock.json",
    "**/uv.lock"
  ],
  "words": [
    "Segoe",
    "Deutsch",
    "conftest",
    "pytestmark",
    "usefixtures",
    "basetemp",
    "capsys",
    "nonblocking",
    "buildconf",
    "compresslevel",
    "distpath",
    "ffplay",
    "ffprobe",
    "Gyan",
    "LOCALAPPDATA",
    "noconfirm",
    "nonfree",
    "notmatch",
    "noupx",
    "onefile",
    "specpath",
    "workpath",
    "shellcheck",
    "Gitleaks",
    "notin",
    "junitxml",
    "rudnerbjoern",
    "Björn",
    "Rudner",
    "AHRS",
    "allclose",
    "Anson",
    "Blackmagic",
    "BLAS",
    "charliermarsh",
    "cspell",
    "DaVinci",
    "dtype",
    "ENOENT",
    "errstate",
    "flexcache",
    "flexparser",
    "frombuffer",
    "Gwazi",
    "hatchling",
    "KaTeX",
    "LAPACK",
    "LASTEXITCODE",
    "librt",
    "micromark",
    "micromatch",
    "missingness",
    "mypy",
    "ndarray",
    "Nevera",
    "NVENC",
    "Onride",
    "OpenBLAS",
    "outputjson",
    "pathspecs",
    "ProRes",
    "Pydantic",
    "Pylance",
    "pyqtgraph",
    "pyright",
    "pyrightconfig",
    "PySide",
    "pytest",
    "PSModulePath",
    "RGBA",
    "rtol",
    "setflags",
    "shiboken",
    "smol",
    "stationarity",
    "Taron",
    "testpaths",
    "tobytes",
    "Voltron",
    "webengine"
  ],
  "languageSettings": [
    {
      "languageId": [
        "python",
        "powershell",
        "javascript",
        "json",
        "jsonc",
        "toml",
        "yaml",
        "markdown"
      ],
      "caseSensitive": false
    }
  ],
  "dictionaries": [
    "python"
  ]
}
