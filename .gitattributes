# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows command scripts need CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve all original reference formats without line-ending conversion.
tests/fixtures/real/** -text
tests/fixtures/rfdb/** -text

# Reference documentation and license texts use normal text handling.
tests/fixtures/real/**/*.md text eol=lf
tests/fixtures/real/**/*.txt text eol=lf
tests/fixtures/rfdb/**/*.md text eol=lf
tests/fixtures/rfdb/**/*.txt text eol=lf
